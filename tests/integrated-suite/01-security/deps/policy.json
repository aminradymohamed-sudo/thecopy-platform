{
  "$schema": "./policy.schema.json",
  "name": "the-copy.deps.policy",
  "version": "1.0.0",
  "description": "سياسة فحص التبعيات — لا تخفّض هذه القيم لتمرير حزمة. أي تعديل يجب أن يكون أكثر صرامة.",

  "severity": {
    "blockOn": ["critical", "high"],
    "warnOn": ["medium"],
    "allowOn": ["low", "informational"]
  },

  "licenses": {
    "allowed": [
      "MIT",
      "ISC",
      "Apache-2.0",
      "BSD-2-Clause",
      "BSD-3-Clause",
      "0BSD",
      "CC0-1.0",
      "Unlicense",
      "Python-2.0",
      "(MIT OR CC0-1.0)",
      "MPL-2.0",
      "(MIT OR Apache-2.0)",
      "(Apache-2.0 OR MIT)",
      "(BSD-3-Clause OR GPL-2.0)"
    ],
    "blocked": [
      "GPL-2.0",
      "GPL-3.0",
      "AGPL-1.0",
      "AGPL-3.0",
      "LGPL-3.0",
      "SSPL-1.0",
      "Commons Clause",
      "BUSL-1.1"
    ]
  },

  "exceptions": [
  ],

  "sbom": {
    "format": "cyclonedx",
    "version": "1.5",
    "required": true
  },

  "auditDepth": "production",
  "minSeverityForFailure": "high"
}
