{
  "name": "@thecopy/e2e-tests",
  "version": "0.1.0",
  "private": true,
  "description": "Comprehensive Selenium Grid test system for thecopy: smoke, functional, integration, performance, regression, TDD, BDD, and system tests.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "lint:types": "tsc -p tsconfig.json --noEmit",
    "grid:up": "podman compose -f podman/podman-compose.grid.yml up -d",
    "grid:down": "podman compose -f podman/podman-compose.grid.yml down",
    "grid:status": "tsx src/utils/grid-status.ts",
    "smoke": "mocha --config .mocharc.json \"tests/smoke/**/*.test.ts\"",
    "smoke:staging": "cross-env TEST_ENV=staging mocha --config .mocharc.json \"tests/smoke/**/*.test.ts\"",
    "smoke:production": "cross-env TEST_ENV=production mocha --config .mocharc.json \"tests/smoke/**/*.test.ts\"",
    "functional": "mocha --config .mocharc.json \"tests/functional/**/*.test.ts\"",
    "functional:staging": "cross-env TEST_ENV=staging mocha --config .mocharc.json \"tests/functional/**/*.test.ts\"",
    "integration": "mocha --config .mocharc.json \"tests/integration/**/*.test.ts\"",
    "integration:staging": "cross-env TEST_ENV=staging mocha --config .mocharc.json \"tests/integration/**/*.test.ts\"",
    "performance": "mocha --config .mocharc.json \"tests/performance/**/*.test.ts\"",
    "performance:api": "mocha --config .mocharc.json \"tests/performance/**/*backend*.test.ts\"",
    "performance:browser": "mocha --config .mocharc.json \"tests/performance/**/*frontend*.test.ts\"",
    "tdd": "mocha --config .mocharc.json \"tests/tdd/**/*.test.ts\"",
    "tdd:watch": "mocha --config .mocharc.json --watch \"tests/tdd/**/*.test.ts\" \"src/testing/**/*.ts\"",
    "bdd": "mocha --config .mocharc.json \"tests/bdd/**/*.test.ts\"",
    "system": "mocha --config .mocharc.json \"tests/system/**/*.test.ts\"",
    "system:staging": "cross-env TEST_ENV=staging mocha --config .mocharc.json \"tests/system/**/*.test.ts\"",
    "system:journeys": "mocha --config .mocharc.json \"tests/system/user-journey/**/*.test.ts\"",
    "system:cross-module": "mocha --config .mocharc.json \"tests/system/cross-module/**/*.test.ts\"",
    "system:critical": "mocha --config .mocharc.json \"tests/system/critical-paths/**/*.test.ts\"",
    "regression": "mocha --config .mocharc.json \"tests/regression/**/*.test.ts\"",
    "regression:full": "mocha --config .mocharc.json \"tests/{smoke,functional,integration,system,regression}/**/*.test.ts\"",
    "test:all": "mocha --config .mocharc.json \"tests/**/*.test.ts\"",
    "report:merge": "mochawesome-merge \"reports/mochawesome/.jsons/*.json\" -o reports/mochawesome/merged.json && marge reports/mochawesome/merged.json -o reports/mochawesome/html --reportTitle \"thecopy E2E\" --reportFilename index"
  },
  "dependencies": {
    "selenium-webdriver": "4.27.0",
    "@faker-js/faker": "9.3.0",
    "pino": "9.5.0",
    "pino-pretty": "13.0.0"
  },
  "devDependencies": {
    "@types/chai": "5.0.1",
    "@types/mocha": "10.0.10",
    "@types/node": "22.10.2",
    "@types/selenium-webdriver": "4.1.28",
    "chai": "5.1.2",
    "cross-env": "7.0.3",
    "mocha": "11.1.0",
    "mocha-junit-reporter": "2.2.1",
    "mocha-multi-reporters": "1.5.1",
    "mochawesome": "7.1.3",
    "mochawesome-merge": "5.0.0",
    "mochawesome-report-generator": "6.2.0",
    "tsx": "4.19.2",
    "typescript": "5.7.2"
  }
}
