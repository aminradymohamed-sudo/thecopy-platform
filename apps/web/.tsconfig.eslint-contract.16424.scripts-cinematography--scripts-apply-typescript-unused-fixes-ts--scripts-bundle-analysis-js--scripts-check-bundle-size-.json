{
  "extends": "./tsconfig.check.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": [
    "next-env.d.ts",
    "src/env.d.ts",
    "src/global.d.ts",
    "scripts/cinematography/**/*.ts",
    "scripts/cinematography/**/*.tsx",
    "scripts/cinematography/**/*.js",
    "scripts/cinematography/**/*.mjs",
    "scripts/cinematography/**/*.cjs",
    "scripts/apply-typescript-unused-fixes.ts",
    "scripts/bundle-analysis.js",
    "scripts/check-bundle-size.js"
  ],
  "exclude": ["node_modules", ".next", "out", "dist", "build", "coverage"]
}
