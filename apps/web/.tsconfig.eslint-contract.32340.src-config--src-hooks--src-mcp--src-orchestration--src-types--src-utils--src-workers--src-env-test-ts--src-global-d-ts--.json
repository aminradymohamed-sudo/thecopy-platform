{
  "extends": "./tsconfig.check.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": [
    "next-env.d.ts",
    "src/env.d.ts",
    "src/global.d.ts",
    "src/config/**/*.ts",
    "src/config/**/*.tsx",
    "src/config/**/*.js",
    "src/config/**/*.mjs",
    "src/config/**/*.cjs",
    "src/hooks/**/*.ts",
    "src/hooks/**/*.tsx",
    "src/hooks/**/*.js",
    "src/hooks/**/*.mjs",
    "src/hooks/**/*.cjs",
    "src/mcp/**/*.ts",
    "src/mcp/**/*.tsx",
    "src/mcp/**/*.js",
    "src/mcp/**/*.mjs",
    "src/mcp/**/*.cjs",
    "src/orchestration/**/*.ts",
    "src/orchestration/**/*.tsx",
    "src/orchestration/**/*.js",
    "src/orchestration/**/*.mjs",
    "src/orchestration/**/*.cjs",
    "src/types/**/*.ts",
    "src/types/**/*.tsx",
    "src/types/**/*.js",
    "src/types/**/*.mjs",
    "src/types/**/*.cjs",
    "src/utils/**/*.ts",
    "src/utils/**/*.tsx",
    "src/utils/**/*.js",
    "src/utils/**/*.mjs",
    "src/utils/**/*.cjs",
    "src/workers/**/*.ts",
    "src/workers/**/*.tsx",
    "src/workers/**/*.js",
    "src/workers/**/*.mjs",
    "src/workers/**/*.cjs",
    "src/env.test.ts",
    "src/global.d.ts",
    "src/instrumentation-client.ts",
    "src/middleware.test.ts",
    "src/env.d.ts"
  ],
  "exclude": ["node_modules", ".next", "out", "dist", "build", "coverage"]
}
