{
  "name": "@the-copy/web",
  "type": "module",
  "version": "1.2.0",
  "description": "النسخة - Landing Page مع Video Text Mask و Cards Scanner",
  "engines": {
    "node": "24.x",
    "pnpm": ">=10.0.0"
  },
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n next,backend -c cyan,green \"next dev --webpack -p 5000 -H 0.0.0.0\" \"pnpm --dir ../backend run dev\"",
    "dev:backend": "pnpm --dir ../backend run dev",
    "dev:next-only": "next dev --webpack -p 5000 -H 0.0.0.0",
    "dev:fallback": "node --max-old-space-size=4096 scripts/dev-with-fallback.js",
    "genkit:dev": "genkit start -- tsx src/ai/dev.ts",
    "genkit:watch": "genkit start -- tsx --watch src/ai/dev.ts",
    "prebuild": "tsx scripts/clean-source-build-artifacts.ts && tsx scripts/generate-pages-manifest.ts",
    "build": "cross-env NODE_ENV=production NEXT_BUILD_CPUS=1 NEXT_STATIC_GENERATION_MAX_CONCURRENCY=1 NODE_OPTIONS=\"--max-old-space-size=8192 --require=./scripts/node-readlink-eisdir-shim.cjs\" next build --webpack",
    "build:production": "cross-env NODE_ENV=production NEXT_BUILD_CPUS=1 NEXT_STATIC_GENERATION_MAX_CONCURRENCY=1 NODE_OPTIONS=\"--max-old-space-size=8192 --require=./scripts/node-readlink-eisdir-shim.cjs\" next build --webpack",
    "start": "next start -p 5000 -H 0.0.0.0",
    "analyze": "next experimental-analyze",
    "lint": "node scripts/run-eslint-contract.mjs",
    "lint:fix": "eslint . --no-warn-ignored --fix --max-warnings=0 --cache",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "node ../../scripts/quality/typecheck-contract.mjs --project=web",
    "type-check:strict": "node --max-old-space-size=8192 ../../node_modules/typescript/lib/tsc.js -p tsconfig.check.json --noEmit --pretty false",
    "test": "node scripts/run-vitest-chunks.mjs",
    "test:config": "vitest run src/config/apps.config.test.ts src/config/pages.manifest.test.ts src/config/build-script.test.ts src/env.test.ts src/middleware.test.ts src/utils/sanitizer.test.ts",
    "test:smoke": "vitest run \"src/app/__smoke__/simple.test.ts\"",
    "test:cinematography:integration": "tsx scripts/cinematography/run-integration-tests.ts",
    "test:cinematography:e2e": "tsx scripts/cinematography/run-e2e.ts",
    "editor:rag:index": "pnpm --dir ../backend run editor-rag:index",
    "editor:rag:ask": "pnpm --dir ../backend run editor-rag:ask --",
    "editor:rag:stats": "pnpm --dir ../backend run editor-rag:stats",
    "editor:rag:smoke": "pnpm --dir ../backend run editor-rag:smoke",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:real": "vitest run --config vitest.real.config.ts",
    "e2e": "playwright test",
    "e2e:editor:pagination": "playwright test tests/e2e/editor-pagination-layout.spec.ts --project=chromium",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:debug": "playwright test --debug",
    "test:foundation": "node ../../scripts/qa/run-all-foundation-tests.js",
    "test:foundation:integration": "node ../../scripts/qa/run-integration-tests.js",
    "test:foundation:e2e": "node ../../scripts/qa/run-e2e-tests.js",
    "test:all": "pnpm test:coverage && pnpm e2e",
    "performance:report": "node scripts/performance-report.js",
    "a11y:ci": "playwright test --grep @a11y",
    "perf:ci": "playwright test --grep @performance",
    "lighthouse": "lhci autorun",
    "lighthouse:collect": "lhci collect",
    "lighthouse:assert": "lhci assert",
    "lighthouse:upload": "lhci upload",
    "budget:check": "node scripts/check-performance-budget.js",
    "budget:report": "pnpm build && pnpm budget:check",
    "perf:analyze": "node scripts/performance-optimization.js",
    "perf:full": "pnpm build && pnpm budget:report && pnpm perf:analyze",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org $SENTRY_ORG --project $SENTRY_PROJECT .next && sentry-cli sourcemaps upload --org $SENTRY_ORG --project $SENTRY_PROJECT .next",
    "approve-builds": "echo 'Frontend build warnings approved - OpenTelemetry and Sentry warnings are expected and safe' && node -e \"console.log('✅ Build approved with expected warnings')\";",
    "prepush": "pnpm test:config && pnpm test:smoke",
    "ci": "pnpm lint && pnpm type-check && pnpm test && pnpm build && pnpm e2e"
  },
