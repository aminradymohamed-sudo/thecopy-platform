{
  "extends": "./tsconfig.check.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": [
    "next-env.d.ts",
    "src/env.d.ts",
    "src/global.d.ts",
    "playwright.directors-studio-remediation.config.ts",
    "src/ai/dev.ts",
    "src/ai/gemini-core.ts",
    "src/ai/genkit.ts",
    "src/ai/ai-team-brainstorming.ts",
    "src/ai/gemini-service.ts",
    "src/app/(auth)/**/*.ts",
    "src/app/(auth)/**/*.tsx",
    "src/app/(auth)/**/*.js",
    "src/app/(auth)/**/*.mjs",
    "src/app/(auth)/**/*.cjs",
    "src/app/api/**/*.ts",
    "src/app/api/**/*.tsx",
    "src/app/api/**/*.js",
    "src/app/api/**/*.mjs",
    "src/app/api/**/*.cjs",
    "src/app/ui/**/*.ts",
    "src/app/ui/**/*.tsx",
    "src/app/ui/**/*.js",
    "src/app/ui/**/*.mjs",
    "src/app/ui/**/*.cjs",
    "src/app/__integration__/**/*.ts",
    "src/app/__integration__/**/*.tsx",
    "src/app/__integration__/**/*.js",
    "src/app/__integration__/**/*.mjs",
    "src/app/__integration__/**/*.cjs",
    "src/app/__regression__/**/*.ts",
    "src/app/__regression__/**/*.tsx",
    "src/app/__regression__/**/*.js",
    "src/app/__regression__/**/*.mjs",
    "src/app/__regression__/**/*.cjs",
    "src/app/__smoke__/**/*.ts",
    "src/app/__smoke__/**/*.tsx",
    "src/app/__smoke__/**/*.js",
    "src/app/__smoke__/**/*.mjs",
    "src/app/__smoke__/**/*.cjs"
  ],
  "exclude": ["node_modules", ".next", "out", "dist", "build", "coverage"]
}
